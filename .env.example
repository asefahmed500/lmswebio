# Required
DATABASE_URL="mongodb://localhost:27017/lmsio"
JWT_SECRET="replace-with-at-least-32-random-characters"
JWT_REFRESH_SECRET="replace-with-a-different-32-character-secret"

# Optional
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Payments — leave unset to run in demo mode (auto-enrol without Stripe)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Email — leave unset to log mail to the console
EMAIL_HOST=""
EMAIL_PORT="587"
EMAIL_USER=""
EMAIL_PASS=""
EMAIL_FROM="LMSio <no-reply@example.com>"

# Seeding
SEED_DEFAULT_PASSWORD=""
